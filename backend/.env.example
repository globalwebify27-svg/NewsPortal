# =============================================================================
# Global Awaaz — Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ─── SERVER ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# ─── DATABASE (MySQL via Docker) ────────────────────────────────────────────
DATABASE_URL="mysql://root:GlobalAwaaz@2025@localhost:3306/global_awaaz"
# For Docker Compose use:
# DATABASE_URL="mysql://root:GlobalAwaaz@2025@mysql:3306/global_awaaz"

# ─── REDIS ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# For Docker Compose use:
# REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ─── EMAIL (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@globalawaaz.com
EMAIL_FROM_NAME=Global Awaaz

# ─── GOOGLE OAUTH ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ─── FACEBOOK OAUTH ──────────────────────────────────────────────────────────
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# ─── CLOUDINARY (Media Storage) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=global_awaaz_media

# ─── MEILISEARCH (Full-text Search) ──────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
# For Docker Compose:
# MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=GlobalAwaaz-MeiliSearch-Master-Key-2025
MEILISEARCH_INDEX_ARTICLES=articles

# ─── AI (Google Gemini) ───────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─── FIREBASE (Push Notifications) ───────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── MISC ─────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10
MAX_FILE_SIZE_MB=50
LOG_LEVEL=debug
CORS_CREDENTIALS=true
