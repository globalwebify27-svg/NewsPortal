# =============================================================================
# Global Awaaz — Environment Configuration Template
# Copy this file to .env.local for local development or set in CI/CD pipeline
# =============================================================================

# Database Connection (MySQL / MariaDB)
DATABASE_URL="mysql://username:password@localhost:3306/newsdb"

# JWT Secret Key for Session Authentication (Random 64-character hex string)
JWT_SECRET="generate-a-secure-random-64-character-hex-secret-key-here"

# Super Admin Initial Setup Credentials (Used for first bootstrap)
SUPER_ADMIN_EMAIL="admin@globalawaaz.com"
SUPER_ADMIN_PASSWORD="ChooseAStrongAdminPassword2026!"

# Media & Storage Configuration
HOSTINGER_MEDIA_ORIGIN="https://yellowgreen-rook-384455.hostingersite.com"
HOSTINGER_MEDIA_SECRET="your-media-upload-secret"

# Cloudinary (Optional Media CDN)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Node Environment
NODE_ENV="production"
PORT=3000
